# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editors ───────────────────────────────────────────────────────────────────
*.code-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Claude Code personal settings ─────────────────────────────────────────────
.claude/settings.local.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Build output (py2app) ─────────────────────────────────────────────────────
build/bdist.*/
build/build/
build/dist/
dist/

# ── Secrets — never commit these to a repository ──────────────────────────────
.env
.env.*
!.env.example
!.env.sample
secrets.json
secrets.yml
secrets.yaml
auth.json
credentials.json
credentials.yml
credentials.yaml
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks

# ── PHP / logs ────────────────────────────────────────────────────────────────
vendor/
error_log
*.log

# ── Database files (allow schema files with e.g. !src/database/migrations/*.sql)
*.sql
*.sqlite
*.sqlite3
*.db

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Project-specific ──────────────────────────────────────────────────────────
